{
  "manifest_version": 3,
  "name": "Locus",
  "short_name": "Locus",
  "version": "0.1.0",
  "description": "Save the exact passage, keep it on your computer, use it with any AI.",
  "author": "Maharshi Pandya",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Locus",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage", "unlimitedStorage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open Locus"
    },
    "save-passage": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the selected passage"
    },
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Save this page"
    }
  }
}
